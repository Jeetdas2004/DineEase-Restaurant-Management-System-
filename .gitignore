# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Production build artifacts
dist/
frontend/dist/
build/

# Environment files (never commit private secrets)
.env
.env.local
.env.production
.env.development
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local

# Allow example env files
!.env.example
!backend/.env.example
!frontend/.env.example

# Runtime uploads and local cache
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Vercel and editor cache
.vercel
.vscode/
.idea/
.DS_Store
Thumbs.db
